{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "/static/encendido-stage.mjs": [
        "./src/stage-types.d.ts"
      ],
      "/static/rehearsal.mjs": [
        "./src/runtime-any.d.ts"
      ],
      "/static/vendor/mediapipe/vision_bundle.mjs": [
        "./src/runtime-any.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}